# Foody Backend — copiar a .env y completar (NUNCA commitear .env)

# PostgreSQL
# Supabase self-hosted + Supavisor (puerto 5432):
DATABASE_URL=postgresql://postgres.your-tenant-id:TU_PASSWORD@localhost:5432/postgres
# Solo docker-compose.dev.yml:
# DATABASE_URL=postgresql://postgres:foody_password_dev@localhost:5432/foody_db

# Supabase self-hosted (API Kong gateway suele ser :8000)
# RT-ENV-01: una sola línea SUPABASE_URL (si hay dos, Node usa la última).
SUPABASE_URL=http://192.168.1.100:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Storage (imágenes menú) — bucket público; migración 057
SUPABASE_STORAGE_BUCKET=foody-assets

# JWT (generar secreto largo en producción)
# TTL access; renovar con POST /auth/refresh mientras sea válido.
# Logout / cambio password invalidan vía usuarios.token_version (claim JWT `tv`).
# No cambies JWT_SECRET en local sin reiniciar sesión en la app (invalida todos los JWT).
JWT_SECRET=foody_jwt_secret_cambiar_en_produccion
# Dev: 7d OK. Producción: obligatorio corto (1h / 2h / 15m / 1d) — validar-config-produccion.
# Flutter renueva con POST /auth/refresh.
JWT_EXPIRACION=7d

# RT-SEC-01: pepper HMAC de topics staff (default = JWT_SECRET). Rotar invalida canales en vuelo.
# REALTIME_CANAL_PEPPER=

# Firebase FCM — para ENVIAR push desde el backend (NestJS)
#
# Opción A (recomendada): ruta al archivo JSON descargado de Firebase Console.
#   1. console.firebase.google.com → proyecto foody-pin2
#   2. ⚙ Configuración → Cuentas de servicio → Generar nueva clave privada
#   3. Guarda el .json donde quieras (ej. C:\Users\javier\Downloads\foody-pin2-firebase.json)
#   4. Pega aquí la ruta COMPLETA a ese archivo:
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\Users\javier\Downloads\foody-pin2-firebase.json
#
# Opción B: pegar el JSON entero en una línea (avanzado, poco cómodo en Windows)
# FIREBASE_SERVICE_ACCOUNT_JSON=
#
# Sin ninguna de las dos, la app SÍ registra tokens FCM en BD pero el backend no envía push.
#
# Legacy (no usa el código actual de FcmService; puedes dejar vacío):
FIREBASE_PROJECT_ID=foody-pin2
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Servidor Python impresión (WebSocket NestJS → escpos / archivo)
FOODY_PRINTER_WS=ws://127.0.0.1:8765
# En el PC restaurante: FOODY_PRINTER_MODE=archivo|auto|red (ver docs/IMPRESION_RESTAURANTE.md)

# Servidor
PUERTO=3000
ENTORNO=desarrollo
# Rate limit: en desarrollo el guard es NO-OP salvo RATE_LIMIT_FORZAR=1 (QA SEC-RLIMIT).
# En producción (ENTORNO=produccion) siempre activo. Staging: FORZAR=1 o ENTORNO=produccion.
# RATE_LIMIT_FORZAR=0
# Antispike registro self-service (VIRAL): 0/false cierra altas; cupo 0 = sin tope.
# REGISTRO_RESTAURANTE_ABIERTO=1
# REGISTRO_CUPO_DIARIO=100
# REGISTRO_MAX_POR_MINUTO=30
# BCRYPT_ROUNDS=10
WEBSOCKET_IMPRESION_PUERTO=3001

# Pool PostgreSQL (opcional; default 10 en dev)
# En VPS 2C/4GB con 10–15 sedes activas: 20–30
DB_POOL_MAX=25
# Máximo de espera para adquirir/abrir conexión en el pool (default 5 s)
DB_POOL_CONNECT_TIMEOUT_MS=5000
# FCM: tope de reintentos en cola antes de abandonar (default 10)
# FCM_MAX_INTENTOS=10

# CORS — en desarrollo puedes usar *; en producción dominios concretos
CORS_ORIGEN=*

# Wompi (Colombia) — acepta ambos nombres de variable
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# Alias legacy en .env local: WOMPI_SECRET_KEY, WOMPI_EVENT_KEY
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRIDAD=
WOMPI_AMBIENTE=sandbox
# Tras pagar: bridge HTTPS → foody://plan (Wompi no acepta custom scheme directo).
# El backend añade ?pago_id=…  Fallback web: WOMPI_EQUIPO_URL
WOMPI_REDIRECT_URL=https://api.foodyy.store/api/v1/pagos/retorno-app
WOMPI_EQUIPO_URL=https://equipo.foodyy.store
# Webhook (tunel/VPS): https://api.foodyy.store/api/v1/pagos/webhook-wompi — docs/WOMPI_PRODUCCION.md
