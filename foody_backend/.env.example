# Foody Backend — copiar a .env y completar (NUNCA commitear .env)

# PostgreSQL
# Supabase self-hosted + Supavisor (puerto 5432):
DATABASE_URL=postgresql://postgres.your-tenant-id:TU_PASSWORD@localhost:5432/postgres
# Solo docker-compose.dev.yml:
# DATABASE_URL=postgresql://postgres:foody_password_dev@localhost:5432/foody_db

# Supabase self-hosted (API Kong gateway suele ser :8000)
SUPABASE_URL=http://192.168.1.100:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# JWT (generar secreto largo en producción)
JWT_SECRET=foody_jwt_secret_cambiar_en_produccion
JWT_EXPIRACION=7d

# Firebase FCM — para ENVIAR push desde el backend (NestJS)
#
# Opción A (recomendada): ruta al archivo JSON descargado de Firebase Console.
#   1. console.firebase.google.com → proyecto foody-pin2
#   2. ⚙ Configuración → Cuentas de servicio → Generar nueva clave privada
#   3. Guarda el .json donde quieras (ej. C:\Users\javier\Downloads\foody-pin2-firebase.json)
#   4. Pega aquí la ruta COMPLETA a ese archivo:
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\Users\javier\Downloads\foody-pin2-firebase.json
#
# Opción B: pegar el JSON entero en una línea (avanzado, poco cómodo en Windows)
# FIREBASE_SERVICE_ACCOUNT_JSON=
#
# Sin ninguna de las dos, la app SÍ registra tokens FCM en BD pero el backend no envía push.
#
# Legacy (no usa el código actual de FcmService; puedes dejar vacío):
FIREBASE_PROJECT_ID=foody-pin2
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Servidor
PUERTO=3000
ENTORNO=desarrollo
WEBSOCKET_IMPRESION_PUERTO=3001

# CORS — en desarrollo puedes usar *; en producción dominios concretos
CORS_ORIGEN=*

# Wompi (Colombia) — acepta ambos nombres de variable
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# Alias legacy en .env local: WOMPI_SECRET_KEY, WOMPI_EVENT_KEY
WOMPI_EVENTS_SECRET=
WOMPI_AMBIENTE=sandbox
WOMPI_REDIRECT_URL=
