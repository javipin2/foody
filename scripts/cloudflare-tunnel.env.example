# Copiar a: scripts/cloudflare-tunnel.env (NO commitear — tiene secreto)
# URLs/puertos/dominio → config/foody-entorno.env (fuente única)
# Guía: docs/CONFIG_ENTORNO_FOODY.md + docs/CLOUDFLARE_TUNNEL_FOODY.md

# Solo el token del conector (Zero Trust → Tunnels → foody → Instalar conector)
TUNNEL_TOKEN=

# Opcional: debe coincidir con TUNNEL_NOMBRE en config/foody-entorno.env
TUNNEL_NOMBRE=foody
